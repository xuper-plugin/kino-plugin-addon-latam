{
  "id": "addon-latam",
  "name": "Addon Latam",
  "version": "1.1.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series en español latino con estrenos al día. Catálogo y enlaces del addon Addon Latam.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-addon-latam",
  "hosts": [
    "addonlatam.duckdns.org"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "streamHosts": "any",
  "secrets": {
    "addonCode": "kino-sealed:v1:Zayp11O-09b0s7B9Zpkubczk7snToVzvkw5V3WsqnFpEq20y-J1benv_F6xshD2kb8K-DjyhwD46JtooNf3Pwy6sgwN7wSp8-bJYYHaLYrBa_qpb"
  },
  "categories": [
    "movies",
    "series"
  ],
  "color": "#F2B84B",
  "section": {
    "label": "Latam",
    "labelEn": "Latam"
  },
  "theme": {
    "accent": "#F2B84B",
    "onAccent": "#1A1206",
    "background": "#0C0D12",
    "surface": "#171923",
    "highlight": "#FFE2A8"
  },
  "telemetry": true,
  "settings": [
    {
      "key": "playSection",
      "type": "section",
      "label": "Reproducción",
      "labelEn": "Playback"
    },
    {
      "key": "quality",
      "type": "select",
      "label": "Calidad preferida",
      "labelEn": "Preferred quality",
      "default": "1080",
      "options": [
        {
          "value": "max",
          "label": "La más alta (4K)",
          "labelEn": "Highest (4K)"
        },
        {
          "value": "1080",
          "label": "Hasta 1080p",
          "labelEn": "Up to 1080p"
        },
        {
          "value": "720",
          "label": "Hasta 720p",
          "labelEn": "Up to 720p"
        }
      ]
    },
    {
      "key": "homeSection",
      "type": "section",
      "label": "Inicio",
      "labelEn": "Home"
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "labelEn": "Home rows",
      "hint": "Los estrenos aparecen en el Inicio de Kino.",
      "hintEn": "New releases appear on Kino's Home.",
      "default": true
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Herramientas",
      "labelEn": "Tools"
    },
    {
      "key": "health",
      "type": "status",
      "label": "Estado del servicio",
      "labelEn": "Service status"
    },
    {
      "key": "cache",
      "type": "status",
      "label": "Caché",
      "labelEn": "Cache"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Comprobar servicio",
      "labelEn": "Check service"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas y fichas?",
      "confirmEn": "Clear the cache of lists and titles?"
    }
  ]
}
